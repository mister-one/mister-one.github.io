    "editorWidget.background": "#F0EEE7",
    "editorWidget.border": "#D1CEC4",

    "input.background": "#F7F6F1",
    "input.border": "#D1CEC4",
    "input.foreground": "#151515",

    "gitDecoration.addedResourceForeground": "#2F8F5B",
    "gitDecoration.conflictingResourceForeground": "#9B4D8F",
    "gitDecoration.deletedResourceForeground": "#B84B4B",
    "gitDecoration.ignoredResourceForeground": "#8D8A82",
    "gitDecoration.modifiedResourceForeground": "#A9681F",
    "gitDecoration.renamedResourceForeground": "#2D7F8F",
    "gitDecoration.stageDeletedResourceForeground": "#B84B4B",
