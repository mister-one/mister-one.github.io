    "editor.findMatchBackground": "#D1CEC488",
    "editor.inactiveSelectionBackground": "#D9D6CB88",
    "editor.lineHighlightBackground": "#F0EEE7",
    "editor.selectionBackground": "#D9D6CB99",
    "editor.wordHighlightBackground": "#E9E7DE66",
    "editor.wordHighlightStrongBackground": "#D1CEC466",

    "editorStickyScroll.background": "#F7F6F1",
    "editorStickyScrollHover.background": "#F0EEE7",
    "editorStickyScroll.border": "#D1CEC4",
    "editorStickyScroll.shadow": "#00000000",
    "editorStickyScrollGutter.background": "#F7F6F1",

    "editorBracketMatch.background": "#E9E7DE44",
    "editorBracketMatch.border": "#BDB9AE",
    "editorCursor.foreground": "#151515",
    "editorGroupHeader.tabsBackground": "#E9E7DE",
    "editorGutter.background": "#F7F6F1",
    "editorIndentGuide.activeBackground1": "#BDB9AE",
    "editorIndentGuide.background1": "#DAD7CE",
    "editorLineNumber.activeForeground": "#151515",
    "editorLineNumber.foreground": "#8D8A82",
    "editorOverviewRuler.border": "#D1CEC4",
