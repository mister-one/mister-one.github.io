    "panelTitle.inactiveForeground": "#6B6963",

    "peekViewEditor.background": "#F7F6F1",
    "peekViewResult.background": "#F0EEE7",

    "quickInput.background": "#F0EEE7",
    "quickInput.foreground": "#151515",

    "sideBar.background": "#F0EEE7",
    "sideBar.border": "#D1CEC4",
    "sideBar.foreground": "#151515",
    "sideBarSectionHeader.background": "#E9E7DE",
    "sideBarSectionHeader.foreground": "#151515",

    "statusBar.background": "#E9E7DE",
    "statusBar.foreground": "#151515",
    "statusBar.noFolderBackground": "#E9E7DE",
    "statusBarItem.hoverBackground": "#D9D6CB",

    "tab.activeBackground": "#F7F6F1",
    "tab.activeForeground": "#151515",
    "tab.border": "#D1CEC4",
